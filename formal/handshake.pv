type key.
type skey.
type pkey.
type kseed.

free c : channel.

const g : pkey [data].
fun exp(pkey, skey) : pkey.
equation forall x : skey, y : skey; exp(exp(g, x), y) = exp(exp(g, y), x).

fun kpk(skey) : pkey.
fun kct(pkey, kseed) : bitstring.
fun kss(pkey, kseed) : key.
reduc forall sk : skey, r : kseed; decap(kct(kpk(sk), r), sk) = kss(kpk(sk), r).

fun kdfa(bitstring, bitstring) : key.
fun kdfb(bitstring, bitstring) : key.
fun k2b(key) : bitstring [data].
fun p2b(pkey) : bitstring [data].
fun senc(bitstring, key) : bitstring.
reduc forall m : bitstring, k : key; sdec(senc(m, k), k) = m.

free secretA : bitstring [private].
free secretB : bitstring [private].

event BeginA(pkey, pkey).
event AcceptA(pkey, pkey, key).
event AcceptB(pkey, pkey, key).

query attacker(secretA).
query attacker(secretB).
query a : pkey, b : pkey, rk : key; inj-event(AcceptA(a, b, rk)) ==> inj-event(AcceptB(a, b, rk)).

let initiator(sA : skey, kA : skey, pB : pkey, kpB : pkey) =
  new eA : skey; new keA : skey; new r1 : kseed;
  let ct1 = kct(kpB, r1) in
  let ss1 = kss(kpB, r1) in
  let dh1 = exp(pB, eA) in
  let ck1 = kdfa(p2b(dh1), k2b(ss1)) in
  let k1  = kdfb(p2b(dh1), k2b(ss1)) in
  event BeginA(exp(g, sA), pB);
  let sealed = senc((p2b(exp(g, sA)), p2b(kpk(kA))), k1) in
  let dh2 = exp(pB, sA) in
  let ck = kdfa(k2b(ck1), p2b(dh2)) in
  let k1b = kdfb(k2b(ck1), p2b(dh2)) in
  out(c, (exp(g, eA), kpk(keA), ct1, sealed, senc(k2b(ck), k1b)));
  in(c, (eB : pkey, ct2 : bitstring, ct3 : bitstring, sealedR : bitstring));
  let ss2 = decap(ct2, kA) in
  let ss3 = decap(ct3, keA) in
  let ikm = (p2b(exp(eB, eA)), p2b(exp(eB, sA)), k2b(ss2), k2b(ss3)) in
  let rk = kdfa(k2b(ck), ikm) in
  let k2 = kdfb(k2b(ck), ikm) in
  let rpub = sdec(sealedR, k2) in
  event AcceptA(exp(g, sA), pB, rk);
  out(c, senc(secretA, rk));

  out(c, eA).

let responder(sB : skey, kB : skey, pA : pkey, kpA : pkey) =
  in(c, (eA : pkey, keApk : pkey, ct1 : bitstring, sealed : bitstring, tag : bitstring));
  let ss1 = decap(ct1, kB) in
  let dh1 = exp(eA, sB) in
  let ck1 = kdfa(p2b(dh1), k2b(ss1)) in
  let k1  = kdfb(p2b(dh1), k2b(ss1)) in
  let (=p2b(pA), =p2b(kpA)) = sdec(sealed, k1) in
  let dh2 = exp(pA, sB) in
  let ck = kdfa(k2b(ck1), p2b(dh2)) in
  let k1b = kdfb(k2b(ck1), p2b(dh2)) in
  if sdec(tag, k1b) = k2b(ck) then
  new eB : skey; new r2 : kseed; new r3 : kseed;
  let ss2 = kss(kpA, r2) in
  let ss3 = kss(keApk, r3) in
  let ikm = (p2b(exp(eA, eB)), p2b(exp(pA, eB)), k2b(ss2), k2b(ss3)) in
  let rk = kdfa(k2b(ck), ikm) in
  let k2 = kdfb(k2b(ck), ikm) in
  new ratchetPub : bitstring;
  event AcceptB(pA, exp(g, sB), rk);
  out(c, (exp(g, eB), kct(kpA, r2), kct(keApk, r3), senc(ratchetPub, k2)));
  out(c, senc(secretB, rk));
  out(c, eB).

process
  new sA : skey; new kA : skey; new sB : skey; new kB : skey;
  out(c, (exp(g, sA), kpk(kA), exp(g, sB), kpk(kB)));
  ( !initiator(sA, kA, exp(g, sB), kpk(kB))
  | !responder(sB, kB, exp(g, sA), kpk(kA)) )
